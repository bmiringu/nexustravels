{
  // Cloudflare Workers — Nexus Travels (static site)
  //
  // "assets.directory" is what tells the Worker which folder to serve.
  // An earlier version of this file used "pages_build_output_dir", which
  // is a Cloudflare PAGES key — this project is a Worker, so that key was
  // ignored and the images in public/images were never deployed.
  "name": "nexustravels",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./public/"
  }
}
